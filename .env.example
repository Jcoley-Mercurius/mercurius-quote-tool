# OpenAI API key for AI quote generation
# Without this, the app uses a local SWFL-aware fallback generator
OPENAI_API_KEY=sk-your-key-here

# Google Places API key for address autocomplete on the quote form (server-side only)
# Without this, autocomplete falls back to local SWFL demo suggestions
# Enable "Places API (New)" in Google Cloud Console
GOOGLE_PLACES_API_KEY=your-google-places-api-key

# Supabase (required for auth and persistent storage)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Marketplace lead-assignment ingestion (server-side only; never use NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=
MERCURIUS_MARKETPLACE_WEBHOOK_SECRET=968d3d82a326ead6433f12a1be79b03c791e5ef0136e4447500f7f8d97f6fc17
MERCURIUS_MARKETPLACE_INGESTION_ENABLED=false

# Resend (optional — enables email notifications to contractors on quote acceptance and change requests)
# Sign up free at https://resend.com — 3,000 emails/month on the free tier
# Create an API key at https://resend.com/api-keys
# Verify a sender domain or use the Resend sandbox address (onboarding@resend.dev) for testing
# Without these, email notifications are silently skipped and the app still works fully
RESEND_API_KEY=re_your-resend-api-key
RESEND_FROM_EMAIL=quotes@yourdomain.com
